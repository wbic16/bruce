/// Base store interface with common operations
/// </summary>
public interface IStore<T> where T : EntityBase
{
    T? Get(string id);
    
    /// <summary>
    /// Save entity. Checks version for optimistic concurrency.
    /// </summary>
    Result Save(T entity);
    
    Result Delete(string id);
    
